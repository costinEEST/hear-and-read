{
  "name": "hear-and-read",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.13.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "node scripts/build-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser-logic": "node --test tests/*.test.mjs",
    "test:worker": "npm run build && vitest run",
    "test": "npm run test:browser-logic && npm run test:worker",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261108.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "entities": "^9.0.0"
  }
}
