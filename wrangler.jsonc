{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hear-and-read",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
  },
  "build": {
    "command": "npm run build",
    "watch_dir": [
      "index.html",
      "styles.css",
      "app.js",
      "settings-drawer.js",
      "pwa.js",
      "sw.js",
      "manifest.webmanifest",
      "timing.js",
      "speech.js",
      "languages.js",
      "demos.js",
      "i18n.js",
      "locales",
      "speech-playback.js",
      "robots.txt",
      "sitemap.xml",
      "assets",
      "scripts",
    ],
  },
  "dev": { "ip": "127.0.0.1", "port": 8765 },
}
